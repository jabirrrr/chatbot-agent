# ==============================================================================
# Chatly / Helio Platform - Production & Environment Variables Template
# ==============================================================================
# Copy this file to .env.local (for local frontend development) or .env (for backend)
# In production on Vercel, configure these in: Project Settings -> Environment Variables
#
# IMPORTANT: DO NOT COMMIT REAL SECRETS TO GIT. ALL VALUES BELOW ARE PLACEHOLDERS.
# ==============================================================================

# ==============================================================================
# 🔴 CATEGORY A: REQUIRED PRODUCTION SECRETS (Backend-Only, Must NOT Be Public)
# ==============================================================================

# JWT Signing Secret (Minimum 32 characters)
# Generate on Windows PowerShell: python -c "import secrets; print(secrets.token_hex(32))"
# Generate on Linux/macOS:       openssl rand -hex 32
SECRET_KEY="replace-with-a-secure-random-secret-key-min-32-chars-long"

# Dedicated AES-256-GCM Vault Key (For encrypting OAuth tokens in PostgreSQL)
# Fulfills REQ-INT-01. Must be separate from SECRET_KEY. In production, code actively
# rejects default/insecure keys.
# Generate on Windows PowerShell: python -c "import secrets; print(secrets.token_hex(32))"
# Generate on Linux/macOS:       openssl rand -hex 32
VAULT_SECRET_KEY="replace-with-a-secure-random-vault-key-min-32-chars-long"

# Primary PostgreSQL Connection URL (with pgvector support & SSL enabled)
# For asyncpg (FastAPI runtime), MUST use the postgresql+asyncpg:// scheme:
DATABASE_ASYNC_URL="postgresql+asyncpg://<db_user>:<db_password>@<db_host>:5432/<db_name>?ssl=require"

# Primary LLM API Key (Powers the AI agent, conversation reasoning & tool execution)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key"

# OpenAI API Key (Required for generating 1536-dimensional vector embeddings with text-embedding-3-small)
OPENAI_API_KEY="sk-your-openai-api-key"


# ==============================================================================
# 🔴 CATEGORY B: REQUIRED PRODUCTION CONFIGURATION (Backend-Only, Non-Sensitive)
# ==============================================================================

# Environment Identifier (enforces production security checks and serverless DB pooling)
ENVIRONMENT="production"

# Disable debug mode in production
DEBUG=False

# API Route Prefix
API_V1_PREFIX="/api/v1"

# Production Canonical Frontend Domain (used for OAuth redirect callbacks)
FRONTEND_URL="https://your-production-app.vercel.app"

# Allowed CORS Origins for browser clients (JSON array string)
BACKEND_CORS_ORIGINS='["https://your-production-app.vercel.app"]'


# ==============================================================================
# 🟢 CATEGORY C: PUBLIC VARIABLES (Frontend-Safe, NEXT_PUBLIC_*)
# ==============================================================================

# Frontend API Base URL
# - In unified Vercel deployment: Leave EMPTY ("") so all API requests use same-origin
#   relative paths (/api/v1/...) routed via Next.js rewrites. Contains ZERO secrets.
# - If using a decoupled backend (e.g. Render/Railway): Set to "https://api.yourdomain.com"
NEXT_PUBLIC_API_URL=""


# ==============================================================================
# 🟡 CATEGORY D: OPTIONAL - GOOGLE CALENDAR OAUTH (Required only if GCal is used)
# ==============================================================================

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# [Public/Safe] Authorized JavaScript origins: https://your-production-app.vercel.app
GOOGLE_CLIENT_ID="your-production-google-client-id.apps.googleusercontent.com"

# [SECRET] Client secret for exchanging auth code for tokens
GOOGLE_CLIENT_SECRET="your-production-google-client-secret"

# [Non-Sensitive] Authorized redirect URI (Must exactly match Google Cloud Console)
GOOGLE_REDIRECT_URI="https://your-production-app.vercel.app/api/v1/integrations/google-calendar/callback"


# ==============================================================================
# ⚪ CATEGORY E: OPTIONAL INFRASTRUCTURE & SETTINGS (Have Safe Defaults in Code)
# ==============================================================================

# Database Connection Pool Settings (Optimized for Serverless / PgBouncer / Neon)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_STATEMENT_CACHE_SIZE=0
POSTGRES_SSL_MODE="require"

# Synchronous PostgreSQL connection string (Used by Alembic migrations if run separately)
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>?sslmode=require"

# JWT Expiry Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Origin Regex (allows Vercel preview branch deployments and local testing)
CORS_ORIGIN_REGEX="^https?://(localhost|127\.0\.0\.1)(:\d+)?$|^https://.*\.vercel\.app$"

# OpenRouter Custom Base URL (defaults to https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Alternative LLM Provider Keys (Fallback options in Next.js /api/chat)
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Redis Cache & Broker [SECRET] (Optional - Rate limiter falls back to in-memory)
REDIS_URL="rediss://default:<password>@<host>:6379/0"

# Object Storage (S3 / Cloudflare R2 / AWS / MinIO)
STORAGE_PROVIDER="s3"
MINIO_ENDPOINT="https://s3.amazonaws.com"
MINIO_ROOT_USER=""
MINIO_ROOT_PASSWORD=""
MINIO_BUCKET="chatly-documents"

# Transactional Email (Resend / SendGrid / SMTP)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASSWORD="re_your_api_key"
EMAILS_FROM_EMAIL="notifications@yourdomain.com"
EMAILS_FROM_NAME="Chatly Assistant"

# Stripe Commercial Monetization [SECRET] (Billing runs in simulated mode if unset)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Sentry Error Monitoring (Runs in local logging mode if unset)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional Next.js Proxy Destination (Used in next.config.ts if proxying to external backend)
# FASTAPI_URL="http://127.0.0.1:8000"
