# ==============================================================================
# Chatly / Helio Platform - Production & Environment Variables Template
# ==============================================================================
# Copy this file to .env.local (for local frontend development) or .env (for backend)
# In production on Vercel, configure these in: Project Settings -> Environment Variables
#
# IMPORTANT: DO NOT COMMIT REAL SECRETS TO GIT. ALL VALUES BELOW ARE PLACEHOLDERS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
# In unified Vercel deployment, leave NEXT_PUBLIC_API_URL empty so requests use
# same-origin relative paths (/api/v1/...) via Next.js rewrites.
# If deploying FastAPI on a dedicated domain (Render/Railway/ECS), set the full URL:
# NEXT_PUBLIC_API_URL="https://api.yourdomain.com"
NEXT_PUBLIC_API_URL=""

# Optional proxy destination in development/production (used by next.config.ts)
# FASTAPI_URL="http://127.0.0.1:8000"

# ------------------------------------------------------------------------------
# 2. Core Backend Application Settings (FastAPI)
# ------------------------------------------------------------------------------
APP_NAME="Chatly AI Platform"
ENVIRONMENT="production"
DEBUG=False
API_V1_PREFIX="/api/v1"

# Production Secret Key (Used for JWT signing - must be at least 32 characters)
# Generate with: openssl rand -hex 32
SECRET_KEY="replace-with-a-secure-random-secret-key-min-32-chars-long"

# Dedicated AES-256-GCM Vault Key (Used for encrypting tenant OAuth tokens & credentials)
# Fulfills REQ-INT-01. Generate with: openssl rand -hex 32
VAULT_SECRET_KEY="replace-with-a-secure-random-vault-key-min-32-chars-long"

# JWT Expiration Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------------------
# 3. CORS & Allowed Domains
# ------------------------------------------------------------------------------
# JSON array of allowed origins for browser clients
BACKEND_CORS_ORIGINS='["https://your-production-app.vercel.app"]'

# Regex pattern allowing preview deployments on Vercel and local testing
CORS_ORIGIN_REGEX="^https?://(localhost|127\.0\.0\.1)(:\d+)?$|^https://.*\.vercel\.app$"

# Frontend Canonical URL (used for OAuth redirects)
FRONTEND_URL="https://your-production-app.vercel.app"

# ------------------------------------------------------------------------------
# 4. PostgreSQL Database Configuration (with pgvector)
# ------------------------------------------------------------------------------
# Compatible with Neon, Supabase, AWS RDS, or managed PostgreSQL.
# For asyncpg (FastAPI), use postgresql+asyncpg://
# For Alembic migrations, use postgresql://
DATABASE_ASYNC_URL="postgresql+asyncpg://<db_user>:<db_password>@<db_host>:5432/<db_name>?ssl=require"
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>?sslmode=require"

# Database Pool Settings (Optimized for Serverless / PgBouncer / Neon)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_STATEMENT_CACHE_SIZE=0
POSTGRES_SSL_MODE="require"

# ------------------------------------------------------------------------------
# 5. AI Gateways & LLM Integrations
# ------------------------------------------------------------------------------
# OpenRouter API Key (sk-or-v1-...)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Optional Alternative Direct Providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""

# ------------------------------------------------------------------------------
# 6. Google Cloud OAuth 2.0 & Google Calendar Integration
# ------------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized JavaScript origins: https://your-production-app.vercel.app
# Authorized redirect URIs:      https://your-production-app.vercel.app/api/v1/integrations/google-calendar/callback
GOOGLE_CLIENT_ID="your-production-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-production-google-client-secret"
GOOGLE_REDIRECT_URI="https://your-production-app.vercel.app/api/v1/integrations/google-calendar/callback"

# ------------------------------------------------------------------------------
# 7. Redis Cache & Broker (Optional / External Managed Redis)
# ------------------------------------------------------------------------------
# Upstash Redis, AWS ElastiCache, or Redis Cloud
REDIS_URL="rediss://default:<password>@<host>:6379/0"

# ------------------------------------------------------------------------------
# 8. Object Storage (S3 / Cloudflare R2 / AWS / MinIO)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="s3"
MINIO_ENDPOINT="https://s3.amazonaws.com"
MINIO_ROOT_USER=""
MINIO_ROOT_PASSWORD=""
MINIO_BUCKET="chatly-documents"

# ------------------------------------------------------------------------------
# 9. Transactional Email (Resend / SendGrid / SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASSWORD="re_your_api_key"
EMAILS_FROM_EMAIL="notifications@yourdomain.com"
EMAILS_FROM_NAME="Chatly Assistant"

# ------------------------------------------------------------------------------
# 10. Billing & Error Monitoring
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE=0.1
